# Direct PostgreSQL URL only. Do not use a pooler URL or port 6543.
DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require

# Generate a unique value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
TRUST_PROXY=true

S3_BUCKET=your-private-bucket
S3_REGION=us-east-1
# Leave both empty on EC2 when the instance has an IAM role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=5

APP_DOMAIN=feedbackiq.example.com
ACME_EMAIL=admin@example.com

IMAGE_PREFIX=feedbackiq
IMAGE_TAG=latest
